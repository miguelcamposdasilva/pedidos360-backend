# PLANTILLA PUBLICA. Este archivo SI se sube al repositorio.
#
# Nunca escribas valores reales aqui. Los datos verdaderos van en
# src/main/resources/application-local.yml, que esta en .gitignore.

# --- Base de datos ------------------------------------------------------
# Local (Docker):  jdbc:postgresql://localhost:5432/pedidos360
# AWS RDS:         jdbc:postgresql://<endpoint>.us-east-1.rds.amazonaws.com:5432/pedidos360
DB_URL=
DB_USER=
DB_PASSWORD=

# --- CORS ---------------------------------------------------------------
# Local:  http://localhost:4200
# En AWS: dejar VACIO. Las cabeceras CORS las agrega API Gateway y, si
#         Spring tambien las agrega, el navegador bloquea la respuesta.
CORS_ORIGINS=http://localhost:4200

# --- Microsoft Entra ID -------------------------------------------------
# No son secretos (identificadores publicos), pero se dejan parametrizables
# para poder cambiar de tenant sin recompilar.
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=

# --- RabbitMQ -----------------------------------------------------------
# Local (Docker):  localhost:5672 con guest/guest (valores por defecto).
# AWS / produccion: apuntar al broker real (AmazonMQ, CloudAMQP, etc.).
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
